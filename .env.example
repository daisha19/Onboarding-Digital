# Copie este arquivo para .env e troque os valores marcados como placeholders.
# Nunca coloque senhas ou secrets reais neste arquivo, pois ele pode ser versionado.

# Configuracoes do PostgreSQL local usado pelo docker-compose.
POSTGRES_DB=onboarding_db
POSTGRES_USER=onboarding_user

# Troque por uma senha local forte no .env.
POSTGRES_PASSWORD=[SUA_SENHA_LOCAL]

# Dentro do docker-compose, o host do banco deve ser o nome do servico: db.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL usada pelo backend e pelo Alembic.
# Padrao local via Docker Compose:
DATABASE_URL=postgresql+psycopg2://onboarding_user:[SUA_SENHA_LOCAL]@db:5432/onboarding_db

# Supabase PostgreSQL remoto:
# SO GUILHERME E RAISSA CONECTAM NELE.
# Lembre-se: se esta URL estiver ativa, migrations, seeds e testes podem alterar o banco Supabase.
# DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:PORT/postgres?sslmode=require

# Troque por uma chave longa e aleatoria no .env.
# Exemplo para gerar:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Tempo de expiracao do token JWT, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tamanho maximo de upload, em MB.
UPLOAD_MAX_SIZE_MB=10

# Armazenamento de documentos.
# Use local para desenvolvimento e gcs para enviar arquivos ao Google Cloud Storage.
DOCUMENT_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# Google Cloud Storage. Preencha quando DOCUMENT_STORAGE_BACKEND=gcs.
# O bucket deve ser privado e a conta de servico precisa conseguir criar objetos nele.
GCS_BUCKET_NAME=
GCS_UPLOAD_PREFIX=documentos

# Caminho local para a chave JSON da conta de servico, se usar credenciais por arquivo.
# Em ambientes cloud, prefira Application Default Credentials / service account do runtime.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\service-account.json

# Origens autorizadas para o frontend consumir a API, separadas por virgula.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed local para testes: use estes valores como exemplo ao criar o primeiro RH.
# O script nao le estes campos automaticamente; eles servem como referencia local.
# INITIAL_RH_EMAIL=rh@example.com
# INITIAL_RH_PASSWORD=change-me
# INITIAL_RH_MATRICULA=1001
# INITIAL_RH_CARGO=Analista de RH
